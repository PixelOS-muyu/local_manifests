  <project path="device/xiaomi/muyu" name="android_device_xiaomi_muyu" remote="muyu" />
  <!-- Prebuilt stock kernel (OS3.0.7.0), unmodified -->
  <project path="device/xiaomi/muyu-kernel" name="android_device_xiaomi_muyu-kernel" remote="micliff-dev" revision="fb567104bdfadae72478c49e423b0e3a332ac50f" upstream="lineage-23.2" clone-depth="1" />
  <project path="vendor/xiaomi/muyu" name="android_vendor_xiaomi_muyu" remote="muyu" clone-depth="1" />
