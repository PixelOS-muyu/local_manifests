<manifest>
  <remote name="muyu" fetch="https://github.com/PixelOS-muyu" revision="sixteen-qpr2" />
  <remote name="micliff-dev" fetch="https://github.com/Xiaomi-Pad-7-Pro-Resources" revision="lineage-23.2" />

  <!-- LineageOS sepolicy + compat entry for the adaptive keyboard backlight property -->
  <remove-project name="LineageOS/android_device_lineage_sepolicy" />
